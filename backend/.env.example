# ─── ATELIER Backend Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/Atelier

# Frontend URL for CORS
# Development: http://localhost:5500
# Production: https://atelier.gosr.lol
FRONTEND_URL=https://atelier.gosr.lol

# Firebase Service Account (path relative to backend/)
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=../ateliershoppingsite-firebase-adminsdk-fbsvc-3d73a527ee.json